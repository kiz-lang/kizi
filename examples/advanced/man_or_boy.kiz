# A(10) = -67
fn K(n)
    return fn
        return n
    end
end

fn a(k, x1, x2, x3, x4, x5)
    fn b
        k = k - 1
        return a(k, b, x1, x2, x3, x4)
    end
    if k <= 0
        return x4() + x5()
    else
        return b()
    end
end

print("A(10) =", a(10, K(1), K(-1), K(-1), K(1), K(0)))
