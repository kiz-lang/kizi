# 基准：宽整数运算（Karatsuba乘法在不同位数下的表现）
a = 12345678901234567890123456789012345678901234567890
b = 98765432109876543210987654321098765432109876543210

WARMUP = 500
N = 5000

i = 0
while i < WARMUP
    a * b
    i = i + 1
end

start = now()
i = 0
r = 0
while i < N
    r = a * b
    i = i + 1
end
elapsed = now() - start
print("bigint_mul_40digits", N, ":", elapsed, "ns")
print("digits_ok:", len(Str(r)) >= 79)
